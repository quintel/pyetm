"""
PyETM Quickstart Guide
======================
This script demonstrates the basic functionality of pyetm.

Generated by: pyetm init
Learn more: https://docs.energytransitionmodel.com/main/pyetm/introduction
"""

from pyetm.models import Scenario

# =============================================================================
# 1. CREATE A SCENARIO
# =============================================================================
# Create a new scenario for the Netherlands (nl2023) targeting year 2050
# You can also use other area codes like 'de', 'uk', 'eu27', etc.
# See: https://docs.energytransitionmodel.com/api/area-codes

print("Creating a new scenario...")
scenario = Scenario.create(
    area_code="nl2023",
    end_year=2050,
    title="My First PyETM Scenario"
)

print(f"✓ Created scenario {scenario.id}")
print(f"  Title: {scenario.title}")
print(f"  Area: {scenario.area_code}")
print(f"  End year: {scenario.end_year}")
print(f"  View at: https://my.energytransitionmodel.com/saved_scenarios/{scenario.id}\n")


# =============================================================================
# 2. UPDATE SCENARIO INPUTS (SLIDERS)
# =============================================================================
# Modify the scenario by setting input values (like adjusting sliders in the UI)
# Input keys can be found in the ETM interface or documentation

print("Updating scenario inputs...")
scenario.update_inputs({
    # Increase solar PV capacity to 15 GW
    "capacity_of_energy_power_solar_pv_solar_radiation": 15000,

    # Increase offshore wind capacity to 20 GW
    "capacity_of_energy_power_wind_turbine_offshore": 20000,

    # Set 50% of households to use heat pumps
    "households_heater_heatpump_air_water_electricity_share": 50.0,
})

print("✓ Inputs updated\n")


# =============================================================================
# 3. VIEW SCENARIO INPUTS
# =============================================================================
# Access all inputs as a pandas DataFrame

print("Sample of scenario inputs:")
inputs_df = scenario.inputs.to_dataframe()
print(inputs_df[["user", "default", "unit"]].head(10))
print(f"  Total inputs: {len(inputs_df)}\n")


# =============================================================================
# 4. QUERY RESULTS WITH GQUERIES
# =============================================================================
# Gqueries let you extract calculated values from the energy model
# See: https://docs.energytransitionmodel.com/api/gqueries

print("Querying scenario results...")
results = scenario.gquery(
    "total_co2_emission",
    "dashboard_total_costs",
    "dashboard_renewability",
    "total_electricity_produced"
)

print("✓ Query results:")
for key, result in results.items():
    # Get the future value (end year)
    value = result.future
    unit = result.unit
    print(f"  {key}: {value:.2f} {unit}")
print()


# =============================================================================
# 5. GET HOURLY OUTPUT CURVES
# =============================================================================
# Access hourly electricity production/demand data (8760 hours per year)

print("Fetching hourly electricity curves...")
hourly_curves = scenario.get_hourly_output_curves("electricity")

print(f"✓ Retrieved {len(hourly_curves.columns)} electricity curves")
print(f"  Curves include: {', '.join(hourly_curves.columns[:5].tolist())}...")
print(f"  Data shape: {hourly_curves.shape} (8760 hours × curves)\n")


# =============================================================================
# 6. COPY AND MODIFY A SCENARIO
# =============================================================================
# Create a new scenario based on an existing one

print("Creating a variant scenario...")
variant = Scenario.from_existing(
    scenario_id=scenario.id,
    title="High Renewables Variant"
)

# Push it even further with renewables
variant.update_inputs({
    "capacity_of_energy_power_solar_pv_solar_radiation": 25000,
    "capacity_of_energy_power_wind_turbine_offshore": 30000,
})

print(f"✓ Created variant scenario {variant.id}\n")


# =============================================================================
# 7. EXPORT TO EXCEL
# =============================================================================
# Export scenario data to Excel for analysis or sharing

print("Exporting scenario to Excel...")
scenario.to_excel("my_scenario.xlsx")
print("✓ Exported to: my_scenario.xlsx\n")


# =============================================================================
# NEXT STEPS
# =============================================================================
print("=" * 60)
print("🎉 Quickstart complete!")
print("=" * 60)
print("\nNext steps:")
print("1. Explore the examples/ directory for advanced features")
print("2. Read the docs: https://docs.energytransitionmodel.com/main/pyetm/")
print("3. View your scenarios: https://my.energytransitionmodel.com/saved_scenarios")
print("4. Check input keys: https://docs.energytransitionmodel.com/api/inputs")
print("5. Browse gqueries: https://docs.energytransitionmodel.com/api/gqueries")
